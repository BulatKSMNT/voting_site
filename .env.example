# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False

# Database
DB_ENGINE=postgres
POSTGRES_DB=voting
POSTGRES_USER=voting
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Telegram
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=host_battle_bot
FULL_ADMIN_IDS=
LIMITED_ADMIN_IDS=

# Django REST API
DJANGO_API_TOKEN=your-django-api-token
DJANGO_API_BASE=http://web:8000/voting/api

# Logs: background requests never enter the main log or voting audit
TRAFFIC_LOG_MAX_BYTES=5242880
TRAFFIC_LOG_BACKUPS=2
TRAFFIC_LOG_DAYS=7
APP_LOG_DAYS=30

# Per-actor quotas; Docker Compose sets CACHE_URL to its shared Redis service
CACHE_URL=
API_ANON_RATE=60/min
API_READ_RATE=120/min
API_VOTE_RATE=60/min
API_MANAGE_RATE=120/min
